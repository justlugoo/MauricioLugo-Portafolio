---
import Figure from "@/components/Figure.astro"
import SectionHead from "@/components/SectionHead.astro"
import education from "@data/education.json"
import sections from "@data/sections.json"
import type { Degree, Language } from "@/types"

const degrees = education.degrees as Degree[]
const languages = education.languages as Language[]
const copy = sections.education
---

<section
  id="education"
  class="section section--tint"
  data-section
  aria-labelledby="education-title"
>
  <Figure variant="steps" />

  <div class="container">
    <SectionHead id="education" title={copy.title} subtitle={copy.subtitle} />

    <ul class="cols cols--3">
      {
        degrees.map((item) => (
          <li class="item">
            <h3 class="item-title">{item.degree}</h3>
            <p class="institution">{item.institution}</p>
            <ul class="details">
              <li>{item.location}</li>
              {item.details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
          </li>
        ))
      }

      <li class="item">
        <h3 class="item-title">Idiomas</h3>
        <ul class="languages">
          {
            languages.map((language) => (
              <li>
                {language.name} <span class="level">· {language.level}</span>
              </li>
            ))
          }
        </ul>
      </li>
    </ul>
  </div>
</section>

<style>
  .item-title {
    font-size: clamp(1.25rem, 1.15rem + 0.45vw, 1.5rem);
    line-height: 1.25;
  }

  /* Misma jerarquía que Certificaciones: título, entidad y datos en letra pequeña */
  .institution {
    margin-block-start: 0.35rem;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .details {
    display: grid;
    gap: 0.1rem;
    margin-block-start: 0.15rem;
    font-size: var(--fs-sm);
    color: var(--ink-3);
  }

  /* Los idiomas se leen como las tecnologías: lista corta en letra pequeña */
  .languages {
    display: grid;
    gap: 0.45rem;
    margin-block-start: 0.9rem;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  .level {
    color: var(--ink-3);
  }

  /* En tableta hay dos columnas: Idiomas ocupa toda la fila, en vez de quedar sola en un lado */
  @media (min-width: 44rem) and (max-width: 63.99rem) {
    .item:last-child {
      grid-column: 1 / -1;
    }

    .languages {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem 2.5rem;
    }
  }
</style>
