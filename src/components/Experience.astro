---
import Figure from "@/components/Figure.astro"
import SectionHead from "@/components/SectionHead.astro"
import experience from "@data/experience.json"
import sections from "@data/sections.json"
import type { ExperienceEntry } from "@/types"

const entries = experience as ExperienceEntry[]
const copy = sections.experience
---

<section
  id="experience"
  class="section section--tint"
  data-section
  aria-labelledby="experience-title"
>
  <Figure variant="ripples" />

  <div class="container">
    <SectionHead id="experience" title={copy.title} subtitle={copy.subtitle} />

    <ol class="cols cols--2">
      {
        entries.map((entry) => (
          <li class="item">
            <p class="date">
              {entry.duration} <span class="duration">· {entry.durationShort}</span>
            </p>

            <h3 class="item-title">{entry.position}</h3>
            <p class="company">{entry.company}</p>

            <ul class="achievements">
              {entry.achievements.map((achievement) => (
                <li>{achievement}</li>
              ))}
            </ul>

            <ul class="inline-list" aria-label="Tecnologías usadas">
              {entry.technologies.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .date {
    margin-block-end: 0.6rem;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-2);
  }

  .duration {
    font-weight: 400;
    color: var(--ink-3);
  }

  .item-title {
    max-inline-size: 28ch;
  }

  .company {
    margin-block-start: 0.25rem;
    color: var(--ink-2);
  }

  .achievements {
    display: grid;
    gap: 0.7rem;
    margin-block: 1.25rem 1.4rem;
    font-size: var(--fs-sm);
    line-height: 1.6;
    color: var(--ink);
  }

  .achievements li {
    position: relative;
    padding-inline-start: 1.3rem;
  }

  /* Viñeta: un trazo corto, no un símbolo */
  .achievements li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.8em;
    inline-size: 0.65rem;
    block-size: 1px;
    background: var(--ink-3);
  }
</style>
