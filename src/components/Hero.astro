---
import Icon from "@/components/Icon.astro"
import personal from "@data/personal.json"
import type { Personal } from "@/types"

const { name, title, mission, focus, location, availability, cv } = personal as Personal

// «**así**» marca texto con más peso; el color del texto no cambia
const missionParts = mission.split(/\*\*(.+?)\*\*/g)

// El título une varias partes con « · »: cada parte se mantiene entera al partir la línea
const roleParts = title.split(" · ")
---

<section id="hero" class="hero section" data-section aria-labelledby="hero-title">
  <div class="band" aria-hidden="true">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" fill="none">
      <path
        d="M -5 100 C 20 94, 38 78, 55 56 S 85 14, 105 6"
        stroke="var(--band-mint)"
        vector-effect="non-scaling-stroke"></path>
      <path
        d="M -5 104 C 20 98, 38 82, 55 60 S 85 18, 105 10"
        stroke="var(--band-rose)"
        vector-effect="non-scaling-stroke"></path>
      <path
        d="M -5 108 C 20 102, 38 86, 55 64 S 85 22, 105 14"
        stroke="var(--band-violet)"
        vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>

  <div class="container content">
    <h1 id="hero-title">{name}</h1>
    <p class="role">
      {roleParts.map((part) => <span class="part">{part}</span>)}
    </p>

    <p class="mission">
      {missionParts.map((part, i) => (i % 2 === 1 ? <strong>{part}</strong> : part))}
    </p>

    <dl class="facts">
      <div>
        <dt class="meta">Ubicación</dt>
        <dd>{location}</dd>
      </div>
      <div>
        <dt class="meta">Enfoque</dt>
        <dd>{focus}</dd>
      </div>
      <div>
        <dt class="meta">Estado</dt>
        <dd>{availability}</dd>
      </div>
    </dl>

    <div class="actions">
      <a class="button" href="#projects">Ver proyectos</a>
      <a class="button button--quiet" href={cv.url} target="_blank" rel="noopener noreferrer">
        <Icon name="file-text" />
        Ver CV
        <span class="visually-hidden">(se abre en una pestaña nueva)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    padding-block: clamp(6rem, 5rem + 4vw, 8.5rem) clamp(9.5rem, 8rem + 3vw, 11rem);
    overflow: clip;
  }

  @media (min-width: 56rem) {
    .hero {
      min-block-size: min(46rem, 100svh);
      padding-block-end: clamp(4rem, 3rem + 3vw, 6rem);
    }
  }

  /* El hero abre la página: sin regla superior */
  .hero::before,
  .hero::after {
    display: none;
  }

  .content {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  h1 {
    font-size: var(--fs-display);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 1;
    max-inline-size: 11ch;
    margin-inline-start: -0.04em;
  }

  .role {
    max-inline-size: 40ch;
    font-size: var(--fs-lead);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .part {
    display: block;
  }

  /* En pantallas anchas las partes van en una línea, separadas por un punto */
  @media (min-width: 40rem) {
    .role {
      max-inline-size: none;
    }

    .part {
      display: inline;
    }

    .part:not(:last-child)::after {
      content: " ·";
      margin-inline-end: 0.3em;
    }
  }

  .mission {
    max-inline-size: 36ch;
    margin-block-start: 1rem;
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--ink);
  }

  .mission strong {
    font-weight: 600;
  }

  .facts {
    display: grid;
    gap: 1.25rem 2.5rem;
    inline-size: min(100%, 38rem);
    margin-block-start: 1.5rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--rule);
  }

  .facts dd {
    margin-block-start: 0.25rem;
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--ink);
  }

  @media (min-width: 40rem) {
    .facts {
      grid-template-columns: repeat(3, auto);
      justify-content: start;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-block-start: 1rem;
  }

  /* El borde de la nube: tres hilos paralelos que se separan como bandas de difracción */
  .band {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 10rem;
    pointer-events: none;
  }

  .band svg {
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }

  .band path {
    stroke-width: 1.25;
    stroke-linecap: round;
  }

  @media (min-width: 56rem) {
    .band {
      inset-block: 0;
      inset-inline-start: 46%;
      block-size: auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .band {
      animation: draw 1.8s var(--ease-out) 0.2s both;
    }

    @keyframes draw {
      from {
        clip-path: inset(0 100% 0 0);
      }
      to {
        clip-path: inset(0 0 0 0);
      }
    }
  }
</style>
