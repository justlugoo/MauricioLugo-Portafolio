---
import Figure from "@/components/Figure.astro"
import Icon from "@/components/Icon.astro"
import SectionHead from "@/components/SectionHead.astro"
import certifications from "@data/certifications.json"
import sections from "@data/sections.json"
import type { Certification, CertificationInProgress } from "@/types"

const { credlyProfile } = certifications
const earned = certifications.certifications as Certification[]
const inProgress = certifications.inProgress as CertificationInProgress[]
const copy = sections.certifications
---

<section
  id="certifications"
  class="section section--tint"
  data-section
  aria-labelledby="certifications-title"
>
  <Figure variant="gears" />

  <div class="container">
    <SectionHead id="certifications" title={copy.title} subtitle={copy.subtitle} />

    <ul class="cols cols--3">
      {
        earned.map((cert) => (
          <li class="item">
            <p class="meta">{cert.issuer}</p>
            <h3 class="item-title" lang="en">{cert.name}</h3>
            <p class="credential">
              <a class="link-arrow" href={cert.credentialUrl} target="_blank" rel="noopener noreferrer">
                Ver credencial
                <Icon name="arrow-up-right" />
                <span class="visually-hidden">de {cert.name} (se abre en una pestaña nueva)</span>
              </a>
            </p>
          </li>
        ))
      }
      {
        inProgress.map((cert) => (
          <li class="item">
            <p class="meta">{cert.status}</p>
            <h3 class="item-title pending" lang="en">{cert.name}</h3>
          </li>
        ))
      }
    </ul>

    <p class="profile">
      <a class="link-arrow" href={credlyProfile} target="_blank" rel="noopener noreferrer">
        Ver perfil en Credly
        <Icon name="arrow-up-right" />
        <span class="visually-hidden">(se abre en una pestaña nueva)</span>
      </a>
    </p>
  </div>
</section>

<style>
  .item-title {
    margin-block-start: 0.6rem;
    font-size: clamp(1.25rem, 1.15rem + 0.45vw, 1.5rem);
    line-height: 1.25;
  }

  .credential {
    margin-block-start: 0.9rem;
  }

  .pending {
    color: var(--ink-2);
    font-weight: 400;
  }

  .profile {
    margin-block-start: 2rem;
  }
</style>
